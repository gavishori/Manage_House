rules_version = '2';

// Household finance data.
// - The owner (below) always has access and manages sharing from the app
//   ("שיתוף" button), which writes one document per shared email to
//   /access/{email}. Shared emails are kept there rather than in this file
//   because this repo is public.
// - A shared user can read and edit the finance data and see only their own
//   access document.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'gavishori@gmail.com';
    }
    function allowed() {
      return isOwner()
          || (signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.token.email)));
    }

    match /finance/{docId} {
      allow read, write: if allowed() && docId in ['data', 'state'];
    }

    match /access/{email} {
      allow read: if isOwner() || (signedIn() && request.auth.token.email == email);
      allow create, update: if isOwner()
                            && email == email.lower()
                            && request.resource.data.keys().hasOnly(['addedAt', 'addedBy']);
      allow delete: if isOwner();
    }

    // Temporary password shares. The owner stores a copy of the data that was
    // encrypted in the browser with a password (AES-GCM, PBKDF2 key), so the
    // server never sees the password or the plain data. Anyone holding the
    // random link id can fetch the encrypted copy, but only until expiresAt
    // (at most ~1 hour after creation); after that reads are refused.
    match /shares/{id} {
      allow get: if request.time < resource.data.expiresAt;
      allow list, delete: if isOwner();
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly(['ct', 'iv', 'salt', 'expiresAt', 'createdAt'])
                    && request.resource.data.ct is string
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt <= request.time + duration.value(61, 'm');
      allow update: if false;
    }

    // Everything else (including the old QR-scan records) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
