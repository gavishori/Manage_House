rules_version = '2';

// Household finance data. Only the Google accounts listed here can read or
// write it. To give someone access, add their verified Google email below
// and run: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['gavishori@gmail.com'];
    }

    match /finance/{docId} {
      allow read, write: if allowed() && docId in ['data', 'state'];
    }

    // Everything else (including the old QR-scan records) is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
